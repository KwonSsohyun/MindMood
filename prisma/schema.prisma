// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User 테이블
model AuthUser {
  user_seq     Int       @id @default(autoincrement())
  user_id      String    @unique
  name         String
  email        String    @unique
  password     String
  create_date  DateTime  @default(now()) // 계정 생성일
  select_item  Int[]     // 선택된 카테고리 ID 목록 (배열)
  diaries      Diary[]   // 관계: AuthUser - Diary
}

// 카테고리 테이블
model SelectCategory {
  category_id   Int       @id @default(autoincrement())
  category_name String     @unique
}

// Diary 테이블
model Diary {
  diary_seq       Int      @id @default(autoincrement())
  user_id         String
  mood_level      Int
  mood_emoji      String
  event_info      String?
  event_with      String?
  emotion_type    String?
  emotion_detail  String?
  behavior_style  String?
  behavior_effect String?
  behavior_reason String?
  result_outcome  String?
  result_plan     String?
  self_goal       String?
  entry_date      DateTime
  create_date     DateTime @default(now())
  update_date     DateTime? @updatedAt

  user            AuthUser @relation(fields: [user_id], references: [user_id]) // 관계 정의

  @@index([user_id])
}