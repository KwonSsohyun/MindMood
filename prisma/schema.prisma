// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Users {
  id            Int      @id @default(autoincrement())    // 고유 식별자
  username      String                                    // 사용자 이름 (NULL 불가, 기본적으로 NULL 불가)
  user_id       String   @unique                          // 사용자 ID (Unique, NULL 불가)
  email         String?  @unique                          // 사용자 이메일 (Unique, NULL 가능)
  password      String                                    // 사용자 비밀번호 (NULL 불가, 기본적으로 NULL 불가)
  created_at    DateTime @default(now())                  // 생성일 (Timestamp)
  selected_items String?                                  // 선택한 항목 목록 (기분, 사건, 감정, 행동, 결과, 제안) (VARCHAR)
}
